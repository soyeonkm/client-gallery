{
  "functions": {
    "api/index.js": {
      "includeFiles": "server/fonts/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/heartbeat",
      "schedule": "0 12 */3 * *"
    }
  ]
}
